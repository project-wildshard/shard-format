{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "lib",
    "rewriteRelativeImportExtensions": true,
    "declaration": true
  },
  "include": [
    "cli/**/*.ts",
    "frozen/v0/*.ts",
    "src/*.ts",
    "bench/capture/**/*.ts"
  ]
}
