{
  "name": "@wildshard/wire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Wildshard wire contract and frozen compatibility baseline.",
  "bin": {
    "wire": "./bin.mjs"
  },
  "exports": {
    "./version": "./src/version.mjs",
    "./fixed": "./lib/src/fixed.js",
    "./command": "./lib/src/command.js",
    "./grammar": "./lib/src/grammar.js",
    "./classes": "./lib/src/classes.js",
    "./records": "./lib/src/records.js",
    "./netCommand": "./lib/src/net-command.js",
    "./lock": "./lib/src/lock.js",
    "./v0": "./lib/src/v0.js",
    "./v0Field": "./lib/src/v0-field.js",
    "./events": "./lib/src/events.js",
    "./codec": "./lib/src/codec.js",
    "./game": "./lib/src/game.js",
    "./eventStream": "./lib/src/event-stream.js",
    "./handshake": "./lib/src/handshake.js",
    "./framing": "./lib/src/framing.js",
    "./bits": "./lib/src/bits.js",
    "./major": "./lib/src/major.js",
    "./tables": "./lib/src/tables.js",
    "./tableRead": "./lib/src/table-read.js",
    "./wireError": "./lib/src/wire-error.js",
    "./snapshot": "./lib/src/snapshot.js",
    "./frameRecord": "./lib/src/frame-record.js",
    "./projection": "./lib/src/projection.js",
    "./classTables": "./lib/src/class-tables.js",
    "./rides": "./lib/src/rides.js",
    "./columns": "./lib/src/columns.js",
    "./spawnColumns": "./lib/src/spawn-columns.js"
  },
  "files": [
    "bin.mjs",
    "src/*.mjs",
    "src/*.d.mts",
    "frozen/v0/*.json",
    "frozen/v0/*.ts",
    "lib/**",
    "wire.lock.json",
    "wire.v0.lock.json",
    "fixtures/*.json"
  ],
  "scripts": {
    "check": "pnpm build && git diff --exit-code -- lib && test -z \"$(git ls-files --others --exclude-standard -- lib)\" && node --check bin.mjs && node --check src/version.mjs && tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && oxfmt -c ../../src/.oxfmtrc.json --check bin.mjs src test cli bench/capture && node bin.mjs check --baseline && node bin.mjs check",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node --expose-gc ../../src/scripts/wire/benchmark.mjs",
    "lock": "pnpm build && node bin.mjs lock"
  },
  "dependencies": {
    "valibot": "1.5.0"
  }
}
