// The format docs site (ask A3) on Cloudflare Workers static assets, the way www.wildshard.io is (meta J271), but
// assets only: no Worker script. `bash src/scripts/site/deploy.sh` builds HEAD and deploys it (docs/dev.md, "Docs site").
{
  "name": "wildshard-format",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom domain (it owns the DNS record), on the wildshard.io zone www's Worker uses.
  "routes": [{ "pattern": "format.wildshard.io", "custom_domain": true }],
  "observability": { "enabled": true }
}
